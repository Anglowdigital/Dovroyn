VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase values used by /api. These are not bundled into React.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only OpenAI values. Never prefix these with VITE_.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-astra
# Optional workload overrides. They still use the same OpenAI service and key.
# OPENAI_POD_MODEL=gpt-6-astra
# OPENAI_ANALYSIS_MODEL=gpt-6-astra
# OPENAI_CONTENT_MODEL=gpt-6-astra
# OPENAI_CHAT_MODEL=gpt-6-astra

# Existing Stripe Payment Links used by the landing and pricing pages.
VITE_STRIPE_STARTER_MONTHLY=https://buy.stripe.com/your-link
VITE_STRIPE_STARTER_YEARLY=https://buy.stripe.com/your-link
VITE_STRIPE_GROWTH_MONTHLY=https://buy.stripe.com/your-link
VITE_STRIPE_GROWTH_YEARLY=https://buy.stripe.com/your-link
VITE_STRIPE_PRO_MONTHLY=https://buy.stripe.com/your-link
VITE_STRIPE_PRO_YEARLY=https://buy.stripe.com/your-link
VITE_STRIPE_SCALE_MONTHLY=https://buy.stripe.com/your-link
VITE_STRIPE_SCALE_YEARLY=https://buy.stripe.com/your-link
